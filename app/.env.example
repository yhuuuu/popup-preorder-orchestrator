# Environment Variables

# Bearer token for API authentication (required for all routes except /api/health)
API_TOKEN=dev-token

# Webhook secret for incoming callback security
WEBHOOK_SECRET=dev-webhook-secret

# Frontend origins allowed to call the API (CORS allowlist).
# Comma-separated for multiple origins. Must match the exact scheme, host and
# port Vite prints on startup, otherwise the browser blocks requests.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5175,http://localhost:8080,http://localhost:8081,http://localhost:8082
